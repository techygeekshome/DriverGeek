<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TechyGeeksHome.Common.AboutWindow"
        Width="520" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#0b0b0d"
        Title="About">

  <!-- Self-contained styling so this window looks right dropped into any TGH app -->
  <Window.Styles>
    <Style Selector="TextBlock.name">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#e5e7eb" />
    </Style>
    <Style Selector="TextBlock.tag">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#38bdf8" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.body">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#9ca3af" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#38bdf8" />
      <Setter Property="Padding" Value="0,3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TextBlock.Foreground" Value="#0ea5e9" />
    </Style>
    <Style Selector="Button.kofi">
      <Setter Property="Background" Value="#ff5e5b" />
      <Setter Property="Foreground" Value="#ffffff" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.kofi:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#e54e4b" />
      <Setter Property="TextBlock.Foreground" Value="#ffffff" />
    </Style>

    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#38bdf8" />
      <Setter Property="Foreground" Value="#0b0b0d" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#1a1a1e" />
      <Setter Property="Foreground" Value="#e5e7eb" />
      <Setter Property="BorderBrush" Value="#1f1f22" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
  </Window.Styles>

  <StackPanel Margin="28" Spacing="16">

    <StackPanel Orientation="Horizontal" Spacing="16">
      <Panel Width="64" Height="64">
        <Border x:Name="MonogramBadge" CornerRadius="16" Background="#0A0D16"
                BorderBrush="#38bdf8" BorderThickness="1">
          <TextBlock x:Name="Monogram" Text="TG" FontSize="24" FontWeight="Bold"
                     Foreground="#38bdf8" HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>
        <Image x:Name="IconImage" Width="64" Height="64" IsVisible="False" />
      </Panel>
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock x:Name="AppName" Classes="name" Text="AppName" />
        <TextBlock x:Name="AppTagline" Classes="tag" Text="Tagline" />
        <TextBlock x:Name="AppVersion" Classes="body" Text="Version 1.0.0" Margin="0,4,0,0" />
      </StackPanel>
    </StackPanel>

    <Border Background="#111113" BorderBrush="#1f1f22" BorderThickness="1"
            CornerRadius="16" Padding="18">
      <StackPanel Spacing="10">
        <TextBlock x:Name="AppDescription" Classes="body" Text="Description" />
        <TextBlock x:Name="LicenceText" Classes="body" Text="Licence" />
      </StackPanel>
    </Border>

    <Border Background="#111113" BorderBrush="#1f1f22" BorderThickness="1"
            CornerRadius="16" Padding="18">
      <StackPanel Spacing="8">
        <UniformGrid Columns="2" >
          <Button x:Name="WebsiteButton" Classes="ghost" Content="Website" Margin="0,0,4,0"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button x:Name="ProductButton" Classes="ghost" Content="Product page" Margin="4,0,0,0"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </UniformGrid>
        <UniformGrid Columns="2">
          <Button x:Name="RepoButton" Classes="ghost" Content="Source on GitHub" Margin="0,0,4,0"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button x:Name="IssuesButton" Classes="ghost" Content="Report a problem" Margin="4,0,0,0"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </UniformGrid>
        <Button x:Name="DonateButton" Classes="kofi" Content="Support us on Ko-fi"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
      </StackPanel>
    </Border>

    <Border Background="#111113" BorderBrush="#1f1f22" BorderThickness="1"
            CornerRadius="16" Padding="18">
      <StackPanel Spacing="10">
        <TextBlock Classes="body" Text="More from TechyGeeksHome"
                   FontWeight="SemiBold" Foreground="#e5e7eb" />
        <StackPanel x:Name="FamilyList" Spacing="2" />
        <Button x:Name="FamilyHubButton" Classes="link" Content="See all the free tools" />
      </StackPanel>
    </Border>

    <StackPanel x:Name="CreditsSection" Spacing="6">
      <TextBlock Classes="body" Text="Built with" FontWeight="SemiBold" Foreground="#e5e7eb" />
      <StackPanel x:Name="CreditsList" Spacing="1" />
    </StackPanel>

    <TextBlock x:Name="UpdateStatusText" Classes="body" Text="" />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="CheckUpdatesButton" Classes="ghost" Content="Check for updates" />
      <Button x:Name="CloseButton" Classes="accent" Content="Close" />
    </StackPanel>

  </StackPanel>
</Window>
