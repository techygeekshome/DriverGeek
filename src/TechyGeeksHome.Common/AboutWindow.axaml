<!--
  Shared About window for the Geek range. The colours are the house tokens from each app's
  Themes/Dark.axaml, written as literals on purpose: this is a library, and a StaticResource
  the host has not defined is a hard failure at load. If Dark.axaml changes, change these too.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TechyGeeksHome.Common.AboutWindow"
        Width="520" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#FF0A0D16"
        Title="About">

  <!-- Self-contained styling so this window looks right dropped into any TGH app -->
  <Window.Styles>
    <Style Selector="TextBlock.name">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>
    <Style Selector="TextBlock.tag">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#FF6BA8F0" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.body">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#FF7C8699" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#FF6BA8F0" />
      <Setter Property="Padding" Value="0,3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TextBlock.Foreground" Value="#FF3A85E6" />
    </Style>
    <Style Selector="Button.kofi">
      <Setter Property="Background" Value="#ff5e5b" />
      <Setter Property="Foreground" Value="#ffffff" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Button.kofi:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#e54e4b" />
      <Setter Property="TextBlock.Foreground" Value="#ffffff" />
    </Style>

    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#FF2E78D8" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#FF1B2333" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
      <Setter Property="BorderBrush" Value="#FF2A3549" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
  </Window.Styles>

  <StackPanel Margin="28" Spacing="16">

    <StackPanel Orientation="Horizontal" Spacing="16">
      <Panel Width="64" Height="64">
        <Border x:Name="MonogramBadge" CornerRadius="7" Background="#FF0A0D16"
                BorderBrush="#FF2E78D8" BorderThickness="1">
          <TextBlock x:Name="Monogram" Text="TG" FontSize="24" FontWeight="Bold"
                     Foreground="#FF6BA8F0" HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>
        <Image x:Name="IconImage" Width="64" Height="64" IsVisible="False" />
      </Panel>
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock x:Name="AppName" Classes="name" Text="AppName" />
        <TextBlock x:Name="AppTagline" Classes="tag" Text="Tagline" />
        <TextBlock x:Name="AppVersion" Classes="body" Text="Version 1.0.0" Margin="0,4,0,0" />
      </StackPanel>
    </StackPanel>

    <Border Background="#FF111725" BorderBrush="#FF242D42" BorderThickness="1"
            CornerRadius="7" Padding="18">
      <StackPanel Spacing="10">
        <TextBlock x:Name="AppDescription" Classes="body" Text="Description" />
        <TextBlock x:Name="LicenceText" Classes="body" Text="Licence" />
      </StackPanel>
    </Border>

    <Border Background="#FF111725" BorderBrush="#FF242D42" BorderThickness="1"
            CornerRadius="7" Padding="18">
      <StackPanel Spacing="8">
        <UniformGrid Columns="2" >
          <Button x:Name="WebsiteButton" Classes="ghost" Content="Website" Margin="0,0,4,0"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button x:Name="ProductButton" Classes="ghost" Content="Product page" Margin="4,0,0,0"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </UniformGrid>
        <UniformGrid Columns="2">
          <Button x:Name="RepoButton" Classes="ghost" Content="Source on GitHub" Margin="0,0,4,0"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button x:Name="IssuesButton" Classes="ghost" Content="Report a problem" Margin="4,0,0,0"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </UniformGrid>
        <Button x:Name="DonateButton" Classes="kofi" Content="Support us on Ko-fi"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
      </StackPanel>
    </Border>

    <Border Background="#FF111725" BorderBrush="#FF242D42" BorderThickness="1"
            CornerRadius="7" Padding="18">
      <StackPanel Spacing="8">
        <TextBlock Classes="body" Text="More from TechyGeeksHome"
                   FontWeight="SemiBold" Foreground="#FFFFFFFF" Margin="0,0,0,2" />

        <!--
          One button per app, filled in by BuildFamilyList. Two columns, and the GitHub
          profile button squares the grid off when the number of apps is odd - otherwise it
          drops below as the full-width button instead.
        -->
        <UniformGrid x:Name="FamilyGrid" Columns="2" />

        <Button x:Name="GitHubProfileButton" Classes="accent" Content="All our code on GitHub"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />

        <Button x:Name="FamilyHubButton" Classes="link" Content="See all the free tools"
                HorizontalAlignment="Center" Margin="0,2,0,0" />
      </StackPanel>
    </Border>

    <TextBlock x:Name="UpdateStatusText" Classes="body" Text="" />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="CheckUpdatesButton" Classes="ghost" Content="Check for updates" />
      <Button x:Name="CloseButton" Classes="accent" Content="Close" />
    </StackPanel>

  </StackPanel>
</Window>
