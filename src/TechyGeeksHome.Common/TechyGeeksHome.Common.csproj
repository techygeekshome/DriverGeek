<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared chrome for every TechyGeeksHome desktop tool: the About window and the update check.
    Deliberately dependency-light (Avalonia plus the BCL, nothing else) so this folder can be
    copied straight into the next app's repo without dragging anything along with it.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <DebugType>none</DebugType>
    <RootNamespace>TechyGeeksHome.Common</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
  </ItemGroup>

</Project>
